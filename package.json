{
  "name": "icloud-mail-mcp",
  "version": "1.0.0",
  "description": "MCP server for iCloud Mail on Cloudflare Workers, with a local attachment CLI",
  "scripts": {
    "test": "bun test",
    "dev": "wrangler dev --local-protocol https --https-cert-path .certs/localhost.pem --https-key-path .certs/localhost-key.pem",

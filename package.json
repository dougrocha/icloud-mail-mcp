    "agents": "^0.33.0",
    "imapflow": "^2.11.0",
    "postal-mime": "^4.2.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "icloud-mail-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "MCP_RESOURCE": "https://localhost:8787/mcp"
  },
  // No id: wrangler creates the namespace on first dev or deploy (automatic provisioning).
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // Cloudflare rate limits are approximate and counted per location.
  "ratelimits": [
    { "name": "CONSENT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "SEND_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
